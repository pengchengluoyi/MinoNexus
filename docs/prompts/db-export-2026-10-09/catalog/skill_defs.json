{
  "skills": [
    {
      "id": "run-case",
      "label": "执行测试用例",
      "summary": "看图按前置 / 操作 / 预期推进，调用能力目录里的 function。",
      "category": "device",
      "role": {
        "id": "test-engineer",
        "label": "测试工程师"
      },
      "triggers": [
        "case_run",
        "instruction"
      ],
      "engine": "agent_loop",
      "system_prompt": "",
      "sop": {
        "phases": [
          {
            "id": "prep",
            "job": "agent-vision-plan",
            "exec_job": "agent-vision-exec",
            "tool_kinds": [
              "generic",
              "recovery"
            ],
            "guards": [
              "prep_clear_before_launch",
              "exec_script_params",
              "action_fuse"
            ],
            "advance_on": "milestones"
          },
          {
            "id": "do",
            "job": "agent-vision-plan",
            "exec_job": "agent-vision-exec",
            "tool_kinds": [
              "generic",
              "recovery"
            ],
            "guards": [
              "action_fuse",
              "limit_recovery_retry",
              "require_sms_send_before_otp",
              "block_repeat_get_otp_when_ready",
              "require_otp_before_login_tap",
              "block_fsm_off_step_target",
              "block_back_without_nav_back_semantics",
              "block_assert_in_do"
            ],
            "advance_on": "milestones"
          },
          {
            "id": "check",
            "job": "agent-vision-plan",
            "exec_job": "agent-vision-assert",
            "tool_kinds": [
              "check",
              "recovery"
            ],
            "guards": [
              "deny_mutate",
              "force_case_expectation"
            ],
            "advance_on": "milestones",
            "require": "saw_assert"
          }
        ],
        "inspections": [],
        "pointer": "case_columns",
        "tool_kinds": [
          "generic",
          "check",
          "recovery"
        ],
        "max_steps": 24
      },
      "input": {
        "type": "case",
        "map": {
          "precondition": "case.precondition",
          "steps": "case.steps",
          "expected": "case.expected"
        }
      },
      "view": {
        "id": "case-three-column"
      },
      "enabled": true,
      "builtin": true,
      "sort_order": 10
    },
    {
      "id": "explore-app",
      "label": "应用探索",
      "summary": "在 App 内自由探索，被动采集拓展 Screen Atlas。",
      "category": "device",
      "role": {
